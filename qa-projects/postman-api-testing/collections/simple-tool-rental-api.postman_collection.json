{
  "info": {
    "name": "Simple Tool Rental API \u2014 QA Practice",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "API testing practice: status, tools, auth token flow, orders, negative cases."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://simple-tool-rental-api.glitch.me"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "orderId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "GET status",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/status",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "status"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"status is UP\", function () { pm.response.to.have.status(200); pm.expect(pm.response.json().status).to.eql(\"UP\"); });"
            ]
          }
        }
      ]
    },
    {
      "name": "GET all tools",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tools",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tools"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 and a non-empty array\", function () { pm.response.to.have.status(200); pm.expect(pm.response.json()).to.be.an(\"array\").that.is.not.empty; });",
              "pm.test(\"each tool has id, name and price\", function () { pm.response.json().forEach(t => { pm.expect(t).to.have.all.keys(\"id\",\"name\",\"category\",\"price\",\"available\"); }); });"
            ]
          }
        }
      ]
    },
    {
      "name": "GET tool by id",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tools/4643",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tools",
            "4643"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 and correct tool\", function () { pm.response.to.have.status(200); pm.expect(pm.response.json().id).to.eql(4643); });"
            ]
          }
        }
      ]
    },
    {
      "name": "GET missing tool returns 404",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tools/999999",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tools",
            "999999"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"404 for an unknown tool id\", function () { pm.response.to.have.status(404); });"
            ]
          }
        }
      ]
    },
    {
      "name": "POST create API client (get token)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api-clients",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api-clients"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"clientName\": \"Ravi QA Practice\", \"clientEmail\": \"ravi.qa.practice@example.com\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"201 and token returned\", function () { pm.response.to.have.status(201); pm.expect(pm.response.json().accessToken).to.be.a(\"string\").and.not.empty; });",
              "pm.collectionVariables.set(\"accessToken\", pm.response.json().accessToken);"
            ]
          }
        }
      ]
    },
    {
      "name": "POST create order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"toolId\": 4643, \"customerName\": \"Ravi Kalagara\", \"comment\": \"QA practice order\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"201 and order created\", function () { pm.response.to.have.status(201); pm.expect(pm.response.json().created).to.eql(true); });",
              "pm.collectionVariables.set(\"orderId\", pm.response.json().orderId);"
            ]
          }
        }
      ]
    },
    {
      "name": "GET my orders",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"200 and my order is listed\", function () { pm.response.to.have.status(200); const orders = pm.response.json(); pm.expect(orders.some(o => o.id === pm.collectionVariables.get(\"orderId\"))).to.eql(true); });"
            ]
          }
        }
      ]
    },
    {
      "name": "POST order without token returns 401",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/orders",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"toolId\": 4643, \"customerName\": \"No Token\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"401 when no token is sent\", function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ]
    },
    {
      "name": "DELETE my order",
      "request": {
        "method": "DELETE",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/orders/{{orderId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "orders",
            "{{orderId}}"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"204 on successful delete\", function () { pm.response.to.have.status(204); });"
            ]
          }
        }
      ]
    }
  ]
}
